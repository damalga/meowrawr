<!--slider-1-->
<div class="slider slider-1">
    <div id="slider-header-1" class="slider-header">
        <div id="slider-header-title-1" class="slider-header-title">
            <h2 class="titulo-slider"><a href="#">Meowrawr - Felinos</a></h2>
        </div>
        <div class="slider-header-cities">
            <ul>
                <li><a href="#">Pantherinae</a> |</li>
                <li><a href="#">Felinae</a></li>
            </ul>
        </div>
    </div>

    <div class="slider-main">
        <div id="glider-1" class="glider" data-random-count="9">
            {{#each felids}}
            <!--slide-->
            <div class="card felid-slide" data-felid-index="{{@index}}">
                {{> card}}
            </div>
            <!--end-slide-->
            {{/each}}
            <!--slide-->
            <div class="card more">
                <a href="/felinos" class="card-link">
                    <div class="slide-image">
                        <img src="/assets/extra/extra.png" alt="Conocer más felinos" />
                    </div>
                    <div class="slide-content">
                        <div class="slide-txt">
                            <h3>Conocer más felinos</h3>
                            <div class="location" aria-hidden="true">
                                <img src="/assets/images/location.svg" alt="" />
                                <span>&nbsp;</span>
                            </div>
                            <div class="scientific-info" aria-hidden="true">
                                <span>&nbsp;</span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
            <!--end-slide-->
        </div>
        <!--controls-->
        <div id="glider-arrows-1" class="glider-arrows">
            <div id="prev-1" class="prev"></div>
            <div id="next-1" class="next"></div>
        </div>
        <!--end-controls-->
    </div>
</div>
