<meta charset="UTF-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#BBEAFF" />
<link rel="icon" type="image/png" href="/assets/extra/fav.png" />

<title>{{#if titleOverride}}{{titleOverride}}{{else}}{{#if title}}{{title}} — {{site.name}}{{else}}{{site.name}} — {{site.tagline}}{{/if}}{{/if}}</title>
<meta name="description" content="{{#if description}}{{metaDescription description}}{{else}}{{site.description}}{{/if}}" />

<link rel="canonical" href="{{absoluteUrl page.url}}" />

<meta property="og:type" content="{{#if ogType}}{{ogType}}{{else}}website{{/if}}" />
<meta property="og:site_name" content="{{site.name}}" />
<meta property="og:locale" content="{{site.locale}}" />
<meta property="og:url" content="{{absoluteUrl page.url}}" />
<meta property="og:title" content="{{#if titleOverride}}{{titleOverride}}{{else}}{{#if title}}{{title}} — {{site.name}}{{else}}{{site.name}} — {{site.tagline}}{{/if}}{{/if}}" />
<meta property="og:description" content="{{#if description}}{{metaDescription description}}{{else}}{{site.description}}{{/if}}" />
<meta property="og:image" content="{{#if ogImage}}{{absoluteUrl ogImage}}{{else}}{{site.logo}}{{/if}}" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{#if titleOverride}}{{titleOverride}}{{else}}{{#if title}}{{title}} — {{site.name}}{{else}}{{site.name}} — {{site.tagline}}{{/if}}{{/if}}" />
<meta name="twitter:description" content="{{#if description}}{{metaDescription description}}{{else}}{{site.description}}{{/if}}" />
<meta name="twitter:image" content="{{#if ogImage}}{{absoluteUrl ogImage}}{{else}}{{site.logo}}{{/if}}" />

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "{{site.url}}/#organization",
      "name": "{{site.name}}",
      "url": "{{site.url}}",
      "logo": {
        "@type": "ImageObject",
        "url": "{{site.logo}}"
      },
      "founder": {
        "@type": "Person",
        "name": "{{site.author.name}}",
        "url": "{{site.author.url}}",
        "email": "{{site.author.email}}"
      }
    },
    {
      "@type": "WebSite",
      "@id": "{{site.url}}/#website",
      "url": "{{site.url}}",
      "name": "{{site.name}}",
      "description": "{{site.description}}",
      "inLanguage": "{{site.language}}",
      "publisher": { "@id": "{{site.url}}/#organization" }
    }
  ]
}
</script>

<script src="/assets/scripts/matomo.js" defer></script>
