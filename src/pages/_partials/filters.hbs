<div class="filters-container" role="search">
  <div class="search-box">
    <input
      type="search"
      id="searchInput"
      placeholder="Buscar por nombre..."
      aria-label="Buscar por nombre científico o común"
      autocomplete="off"
    />
    <button id="clearSearch" class="clear-btn" type="button" aria-label="Borrar búsqueda" hidden>×</button>
  </div>

  <div class="filters">
    <label class="filter-group">
      <span>Subfamilia</span>
      <select id="subfamilyFilter">
        <option value="">Todas</option>
        <option value="Pantherinae">Pantherinae</option>
        <option value="Felinae">Felinae</option>
      </select>
    </label>

    <label class="filter-group">
      <span>Linaje</span>
      <select id="lineageFilter">
        <option value="">Todos</option>
        <option value="Panthera">Panthera</option>
        <option value="Bay Cat">Bay Cat</option>
        <option value="Caracal">Caracal</option>
        <option value="Ocelot">Ocelot</option>
        <option value="Lynx">Lynx</option>
        <option value="Puma">Puma</option>
        <option value="Felis">Felis</option>
        <option value="Prionailurus">Prionailurus</option>
      </select>
    </label>

    <label class="filter-group">
      <span>Género</span>
      <select id="genusFilter">
        <option value="">Todos</option>
      </select>
    </label>

    <button id="resetFilters" class="reset-btn" type="button">Limpiar</button>
  </div>

  <div class="results-count" aria-live="polite">
    <span id="resultsCount">41</span> especies
  </div>
</div>
