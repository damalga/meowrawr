---
pagination:
    data: felids
    size: 1
    alias: felid
eleventyComputed:
    permalink: "/felino/{{ felid.id }}/"
    title: "{{ felid.scientificName }}"
---

{{#> base}} {{> header}} {{> nav}}
<main class="felid-detail">
    <article class="felid-article">
        <header class="felid-header">
            <h2>{{felid.scientificName}}</h2>
            {{#if felid.names.es}}
            <p class="common-name">{{felid.names.es}}</p>
            {{/if}}
        </header>

        <div class="felid-content">
            <div class="felid-left">
                <div class="felid-image-container">
                    {{#if felid.iNatPhotos}}
                    <div class="felid-gallery-photos">
                        <div class="gallery-main">
                            <button
                                type="button"
                                class="gallery-arrow gallery-prev"
                                aria-label="Anterior"
                            >
                                ‹
                            </button>
                            <a
                                href="{{lookup (lookup felid.iNatPhotos 0) 'original'}}"
                                target="_blank"
                                rel="noopener"
                                class="gallery-main-link"
                                title="{{lookup (lookup felid.iNatPhotos 0) 'attribution'}}"
                            >
                                <img
                                    src="{{lookup (lookup felid.iNatPhotos 0) 'main'}}"
                                    alt="{{felid.scientificName}} — {{lookup (lookup felid.iNatPhotos 0) 'attribution'}}"
                                    class="gallery-main-img"
                                />
                            </a>
                            <button
                                type="button"
                                class="gallery-arrow gallery-next"
                                aria-label="Siguiente"
                            >
                                ›
                            </button>
                        </div>
                        <p class="gallery-attribution">
                            {{lookup (lookup felid.iNatPhotos 0) 'attribution'}}
                        </p>
                        <div class="gallery-thumbs">
                            {{#each felid.iNatPhotos}}
                            <button
                                type="button"
                                class="gallery-thumb{{#if @first}} active{{/if}}"
                                data-index="{{@index}}"
                                data-main="{{this.main}}"
                                data-original="{{this.original}}"
                                data-attribution="{{this.attribution}}"
                                aria-label="Foto {{@index}}"
                            >
                                <img src="{{this.thumb}}" alt="" loading="lazy" />
                            </button>
                            {{/each}}
                        </div>
                        {{#if felid.iNaturalistURI}}
                        <p class="gallery-more">
                            <a
                                href="{{felid.iNaturalistURI}}"
                                target="_blank"
                                rel="noopener"
                                class="btn btn-forward"
                                >Ver más imágenes →</a
                            >
                        </p>
                        {{/if}}
                    </div>
                    {{else if felid.image}}
                    <img
                        src="{{felid.image}}"
                        alt="{{felid.scientificName}}"
                        class="felid-main-image"
                    />
                    {{else}}
                    <img
                        src="https://via.placeholder.com/500x400/333/fff?text={{felid.scientificName}}"
                        alt="{{felid.scientificName}}"
                        class="felid-main-image"
                    />
                    {{/if}}
                </div>
            </div>

            <div class="felid-info">
                <section class="taxonomy">
                    <h2>Taxonomía</h2>
                    <ul>
                        <li><strong>Nombre científico:</strong> {{felid.scientificName}}</li>
                        <li><strong>Género:</strong> {{felid.genus}}</li>
                        <li><strong>Linaje:</strong> {{felid.lineage}}</li>
                        <li><strong>Subfamilia:</strong> {{felid.subfamily}}</li>
                    </ul>
                </section>

                {{#if felid.wikipediaExtract}}
                <section class="wikipedia-extract">
                    <h2>
                        Descripción
                        {{#if felid.wikipediaExtractEn}}
                        <span class="lang-badge">en inglés</span>
                        {{/if}}
                    </h2>
                    {{{felid.wikipediaExtract}}}
                    {{#if felid.wikipediaURI}}
                    <p class="wiki-source">
                        <a
                            href="{{felid.wikipediaURI}}"
                            target="_blank"
                            rel="noopener"
                            class="btn btn-forward"
                            >Leer más en Wikipedia →</a
                        >
                    </p>
                    {{/if}}
                </section>
                {{/if}}

                <section class="external-links">
                    <h2>Enlaces Externos</h2>
                    <ul>
                        {{#if felid.wikipediaURI}}
                        <li>
                            <a
                                href="{{felid.wikipediaURI}}"
                                target="_blank"
                                rel="noopener"
                                >Wikipedia</a
                            >
                        </li>
                        {{/if}} {{#if felid.wikidataURI}}
                        <li>
                            <a
                                href="{{felid.wikidataURI}}"
                                target="_blank"
                                rel="noopener"
                                >Wikidata</a
                            >
                        </li>
                        {{/if}} {{#if felid.iNaturalistURI}}
                        <li>
                            <a
                                href="{{felid.iNaturalistURI}}"
                                target="_blank"
                                rel="noopener"
                                >iNaturalist</a
                            >
                        </li>
                        {{/if}}
                    </ul>
                </section>

                {{#if felid.iucnStatus}}
                <section class="conservation">
                    <h2>Estado de Conservación</h2>
                    <p class="iucn-status iucn-{{felid.iucnStatus}}">
                        {{felid.iucnStatus}}
                    </p>
                </section>
                {{/if}} {{#if felid.names}}
                <section class="common-names">
                    <h2>Nombres Comunes</h2>
                    <dl>
                        {{#if felid.names.en}}
                        <dt>English:</dt>
                        <dd>{{felid.names.en}}</dd>
                        {{/if}} {{#if felid.names.es}}
                        <dt>Español:</dt>
                        <dd>{{felid.names.es}}</dd>
                        {{/if}} {{#if felid.names.fr}}
                        <dt>Français:</dt>
                        <dd>{{felid.names.fr}}</dd>
                        {{/if}} {{#if felid.names.de}}
                        <dt>Deutsch:</dt>
                        <dd>{{felid.names.de}}</dd>
                        {{/if}} {{#if felid.names.pt}}
                        <dt>Português:</dt>
                        <dd>{{felid.names.pt}}</dd>
                        {{/if}} {{#if felid.names.ja}}
                        <dt>日本語:</dt>
                        <dd>{{felid.names.ja}}</dd>
                        {{/if}} {{#if felid.names.zh}}
                        <dt>中文:</dt>
                        <dd>{{felid.names.zh}}</dd>
                        {{/if}} {{#if felid.names.ar}}
                        <dt>العربية:</dt>
                        <dd>{{felid.names.ar}}</dd>
                        {{/if}}
                    </dl>
                </section>
                {{/if}}
            </div>
        </div>
    </article>
</main>
{{> footer}} {{/base}}
