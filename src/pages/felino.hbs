---
pagination:
    data: felids
    size: 1
    alias: felid
eleventyComputed:
    permalink: "/felino/{{ felid.id }}/"
    title: "{{ felid.scientificName }}"
---

{{#> base}} {{> header}} {{> nav}}
<main class="felid-detail">
    <article class="felid-article">
        <header class="felid-header">
            <h1>{{felid.scientificName}}</h1>
            {{#if felid.names.es}}
            <p class="common-name">{{felid.names.es}}</p>
            {{/if}}
        </header>

        <div class="felid-content">
            <div class="felid-left">
                <div class="felid-image-container">
                    {{#if felid.image}}
                    <img
                        src="{{felid.image}}"
                        alt="{{felid.scientificName}}"
                        class="felid-main-image"
                    />
                    {{else}}
                    <img
                        src="https://via.placeholder.com/500x400/333/fff?text={{felid.scientificName}}"
                        alt="{{felid.scientificName}}"
                        class="felid-main-image"
                    />
                    {{/if}}
                </div>

                <section class="taxonomy">
                    <h2>Taxonomía</h2>
                    <ul>
                        <li><strong>Nombre científico:</strong> {{felid.scientificName}}</li>
                        <li><strong>Género:</strong> {{felid.genus}}</li>
                        <li><strong>Linaje:</strong> {{felid.lineage}}</li>
                        <li><strong>Subfamilia:</strong> {{felid.subfamily}}</li>
                    </ul>
                </section>

                <section class="external-links">
                    <h2>Enlaces Externos</h2>
                    <ul>
                        {{#if felid.wikipediaURI}}
                        <li>
                            <a
                                href="{{felid.wikipediaURI}}"
                                target="_blank"
                                rel="noopener"
                                >Wikipedia</a
                            >
                        </li>
                        {{/if}} {{#if felid.wikidataURI}}
                        <li>
                            <a
                                href="{{felid.wikidataURI}}"
                                target="_blank"
                                rel="noopener"
                                >Wikidata</a
                            >
                        </li>
                        {{/if}} {{#if felid.iNaturalistURI}}
                        <li>
                            <a
                                href="{{felid.iNaturalistURI}}"
                                target="_blank"
                                rel="noopener"
                                >iNaturalist</a
                            >
                        </li>
                        {{/if}}
                    </ul>
                </section>

                <div class="felid-navigation">
                    <a href="/felinos" class="btn btn-back">← Volver al listado</a>
                </div>
            </div>

            <div class="felid-info">
                {{#if felid.wikipediaExtract}}
                <section class="wikipedia-extract">
                    <h2>
                        Descripción
                        {{#if felid.wikipediaExtractEn}}
                        <span class="lang-badge">en inglés</span>
                        {{/if}}
                    </h2>
                    {{{felid.wikipediaExtract}}}
                    {{#if felid.wikipediaURI}}
                    <p class="wiki-source">
                        <a
                            href="{{felid.wikipediaURI}}"
                            target="_blank"
                            rel="noopener"
                            class="btn btn-forward"
                            >Leer más en Wikipedia →</a
                        >
                    </p>
                    {{/if}}
                </section>
                {{/if}}

                {{#if felid.iucnStatus}}
                <section class="conservation">
                    <h2>Estado de Conservación</h2>
                    <p class="iucn-status iucn-{{felid.iucnStatus}}">
                        {{felid.iucnStatus}}
                    </p>
                </section>
                {{/if}} {{#if felid.names}}
                <section class="common-names">
                    <h2>Nombres Comunes</h2>
                    <dl>
                        {{#if felid.names.en}}
                        <dt>English:</dt>
                        <dd>{{felid.names.en}}</dd>
                        {{/if}} {{#if felid.names.es}}
                        <dt>Español:</dt>
                        <dd>{{felid.names.es}}</dd>
                        {{/if}} {{#if felid.names.fr}}
                        <dt>Français:</dt>
                        <dd>{{felid.names.fr}}</dd>
                        {{/if}} {{#if felid.names.de}}
                        <dt>Deutsch:</dt>
                        <dd>{{felid.names.de}}</dd>
                        {{/if}} {{#if felid.names.pt}}
                        <dt>Português:</dt>
                        <dd>{{felid.names.pt}}</dd>
                        {{/if}} {{#if felid.names.ja}}
                        <dt>日本語:</dt>
                        <dd>{{felid.names.ja}}</dd>
                        {{/if}} {{#if felid.names.zh}}
                        <dt>中文:</dt>
                        <dd>{{felid.names.zh}}</dd>
                        {{/if}} {{#if felid.names.ar}}
                        <dt>العربية:</dt>
                        <dd>{{felid.names.ar}}</dd>
                        {{/if}}
                    </dl>
                </section>
                {{/if}}
            </div>
        </div>
    </article>
</main>
{{> footer}} {{/base}}
